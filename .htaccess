# Deny dumps, env, and leftover NiceAdmin demo pages from public access.
<FilesMatch "^(?i).*\.sql$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
<FilesMatch "^(blank|contact|faq|register|components-.*|charts-.*|forms-.*|icons-.*|tables-.*)\.html$">
  Require all denied
</FilesMatch>
